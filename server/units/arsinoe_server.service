[Unit]
Description=gunicorn uvicorn service for Arsinoe Forecast Service API
After=syslog.target

[Service]
User=apiuser
WorkingDirectory=/apps/app_repo/arsinoe_server
ExecStart=/apps/app_repo/arsinoe_server/venv/bin/gunicorn -b 127.0.0.1:8000 main:app  # Simplified command
Restart=always

[Install]
WantedBy=multi-user.target